[Unit]
Description=Dank Calendar
Documentation=https://github.com/AvengeMedia/dankcalendar
After=graphical-session.target
PartOf=graphical-session.target
# With RestartSec=2 the default limit (5 starts per 10s) is never reached, so a persistent failure would restart forever.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
ExecStart=/usr/bin/dcal run --session --hidden
Restart=on-failure
RestartSec=2
Slice=app.slice

[Install]
WantedBy=graphical-session.target
