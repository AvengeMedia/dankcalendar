[Desktop Entry]
Type=Application
Name=Dux Calendar
GenericName=Calendar
Comment=Local, Google, Microsoft, and CalDAV calendars for the dank desktop
Exec=dcal open %U
Icon=dev.duxlabs.calendar
Terminal=false
Categories=Office;Calendar;Qt;
Keywords=calendar;events;agenda;schedule;caldav;ical;ics;vcs;subscribe;invitation;
MimeType=x-scheme-handler/webcal;x-scheme-handler/webcals;text/calendar;text/x-vcalendar;application/ics;
StartupNotify=true
StartupWMClass=dev.duxlabs.calendar
SingleMainWindow=true
